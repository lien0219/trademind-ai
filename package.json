{
  "name": "trademind-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "pnpm": {
    "overrides": {
      "rc-resize-observer": "1.4.3",
      "react": "18.2.0",
      "react-dom": "18.2.0"
    }
  },
  "scripts": {
    "dev": "tsx scripts/dev-all.ts",
    "check:ui-copy": "node scripts/check-ui-copy.mjs",
    "check:dev": "tsx scripts/check-dev-env.ts",
    "seed:demo-data": "powershell -ExecutionPolicy Bypass -File scripts/seed-demo-data.ps1",
    "seed:demo-permissions": "powershell -ExecutionPolicy Bypass -File scripts/seed-demo-permissions.ps1",
    "postinstall": "node scripts/patch-pro-field-antd-select.mjs",
    "dev:infra": "docker compose up -d postgres redis",
    "dev:backend": "tsx scripts/dev-backend.ts",
    "dev:stop": "docker compose stop",
    "dev:reset": "tsx scripts/dev-reset.ts",
    "dev:admin": "pnpm --filter @trademind/admin dev",
    "build:admin": "pnpm --filter @trademind/admin build",
    "preview:admin": "pnpm --filter @trademind/admin preview",
    "test:frontend": "pnpm --filter @trademind/admin test",
    "install:admin:browsers": "pnpm --filter @trademind/admin exec playwright install --with-deps chromium",
    "test:e2e": "pnpm install:admin:browsers && pnpm --filter @trademind/admin exec playwright test --config ../playwright.config.ts",
    "test:e2e:smoke": "pnpm install:admin:browsers && pnpm --filter @trademind/admin exec playwright test --config ../playwright.config.ts --grep @smoke",
    "test:e2e:product-draft": "pnpm --filter @trademind/admin exec playwright test --config ../playwright.config.ts --grep @product-draft",
    "test:e2e:publish-safety": "pnpm --filter @trademind/admin exec playwright test --config ../playwright.config.ts --grep @publish-safety",
    "test:e2e:contracts": "pnpm --filter @trademind/admin exec playwright test --config ../playwright.config.ts --grep @contract",
    "test:e2e:headed": "pnpm --filter @trademind/admin exec playwright test --config ../playwright.config.ts --headed",
    "test:e2e:ui": "pnpm --filter @trademind/admin exec playwright test --config ../playwright.config.ts --ui",
    "test:e2e:report": "pnpm --filter @trademind/admin exec playwright show-report ../playwright-report/admin-e2e",
    "dev:collector": "pnpm --filter @trademind/collector dev",
    "collect:test": "pnpm --filter @trademind/collector collect:test",
    "test:collector": "pnpm --filter @trademind/collector test",
    "test:dev-scripts": "vitest run --environment node scripts/utils/collector-dev-env.test.ts",
    "build:collector": "pnpm --filter @trademind/collector build",
    "install:collector:browsers": "pnpm --filter @trademind/collector exec playwright install chromium",
    "test:backend": "cd backend && go test ./...",
    "test:backend:integration": "cd backend && go test ./internal/testing/integration ./internal/testing/redis",
    "test:db": "cd backend && go test ./internal/testing/integration",
    "test:db:inventory": "cd backend && go test -tags=inventorypostgres -count=1 ./internal/testing/integration",
    "test:db:inventory:race": "cd backend && go test -race -tags=inventorypostgres -count=1 ./internal/testing/integration",
    "test:redis": "cd backend && go test ./internal/testing/redis",
    "test:contracts": "vitest run --config vitest.contracts.config.ts",
    "architecture:check": "node scripts/architecture/check-boundaries.mjs",
    "architecture:affected": "node scripts/architecture/check-affected.mjs",
    "architecture:test": "vitest run --config vitest.architecture.config.ts",
    "architecture:ci": "node scripts/architecture/check-affected.mjs --ci",
    "architecture:baseline": "node scripts/architecture/check-boundaries.mjs",
    "test:affected": "node scripts/testing/test-affected.mjs",
    "quality:affected": "node scripts/quality/check-affected.mjs",
    "quality:ci": "node scripts/quality/check-affected.mjs",
    "quality:all": "node scripts/quality/check-affected.mjs --all",
    "quality:admin": "node scripts/quality/check-typescript-baseline.mjs && pnpm test:frontend",
    "quality:collector": "pnpm build:collector && pnpm test:collector",
    "quality:backend": "node scripts/quality/check-go.mjs",
    "quality:naming": "node scripts/quality/check-naming.mjs",
    "quality:contracts": "pnpm test:contracts",
    "quality:sensitive": "node scripts/quality/check-sensitive-diff.mjs",
    "quality:baseline:admin-ts": "node scripts/quality/check-typescript-baseline.mjs",
    "workflow:check": "node scripts/workflow/check-skill-triggers.mjs",
    "workflow:test": "vitest run --config vitest.workflow.config.ts",
    "workflow:verify": "pnpm workflow:check && pnpm workflow:test"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.2.0",
    "@vitejs/plugin-react": "^4.2.1",
    "execa": "^9.5.2",
    "jsdom": "^29.1.1",
    "picocolors": "^1.1.1",
    "tsx": "^4.19.2",
    "vitest": "^0.34.6"
  }
}
