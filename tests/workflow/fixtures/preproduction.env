P10_PRODUCTION_API_PUBLIC_URL=https://api.example.test
DB_NAME=trademind_preproduction_fixture
P10_DATABASE_PURPOSE=preproduction
P10_DATABASE_ID=preproduction-pg
P10_PRODUCTION_DATABASE_ID=production-pg
P10_TEST_DATABASE_ID=test-pg
